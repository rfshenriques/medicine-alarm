<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_delay"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/setting_delay_desc"
            android:textSize="13sp"
            android:textColor="#666666" />

        <CheckBox android:id="@+id/delay_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/delay_none" />
        <CheckBox android:id="@+id/delay_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/delay_3" />
        <CheckBox android:id="@+id/delay_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/delay_5" />
        <CheckBox android:id="@+id/delay_10" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/delay_10" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDDDDD" android:layout_marginTop="14dp" android:layout_marginBottom="14dp" />

        <CheckBox
            android:id="@+id/chk_hold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_hold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_hold_desc"
            android:textSize="13sp"
            android:textColor="#666666" />

        <CheckBox
            android:id="@+id/chk_snooze"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/setting_snooze" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_snooze_desc"
            android:textSize="13sp"
            android:textColor="#666666" />
    </LinearLayout>
</ScrollView>
